{
  "name": "@open-measure/cli",
  "version": "0.0.1",
  "description": "Non-interactive CLI for Open Measure",
  "type": "module",
  "bin": {
    "open-measure": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@open-measure/web": "workspace:*",
    "@open-measure/spec": "workspace:*"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
